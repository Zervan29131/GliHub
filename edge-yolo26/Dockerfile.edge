# Multi-arch (linux/amd64, linux/arm64) ultra-lightweight Edge YOLO26 image
# Build: docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.edge -t glihub/edge-yolo26:3.0 .
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    EDGE_CONFIG_PATH=/app/config.yaml

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml README.md ./
RUN uv pip install --no-cache -r pyproject.toml

COPY . .
RUN cp -n config.example.yaml config.yaml && mkdir -p /app/edge_data /data/models

EXPOSE 8091

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8091/api/health || exit 1

CMD ["python3", "main.py", "--config", "/app/config.yaml"]

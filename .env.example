# GliHub 2.0 容器化编排环境变量模板（复制为 .env 使用）
POSTGRES_DB=glihub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=

BACKEND_PORT=8080
AI_SERVICE_PORT=8090
FRONTEND_PORT=8088

# OpenAI-Compatible VLM & LLM 配置（默认对接宿主机 Ollama；支持 DeepSeek / 阿里云百炼 / vLLM）
VLM_BASE_URL=http://host.docker.internal:11434/v1
VLM_API_KEY=
VLM_MODEL=qwen2.5vl:7b

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

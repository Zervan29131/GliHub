# ============================================================================
# GliHub 3.0 跨平台单目录部署配置模板（复制为 .env 使用）
# 支持档位: cpu-int8 (默认无卡低精度) | local-q4 (本地4-bit全离线) | gpu-pro (独显全开)
# ============================================================================

DEPLOY_PROFILE=cpu-int8
AI_EXTRAS=--extra cpu-int8

# 统一数据持久化根目录（备份迁移仅需打包此目录）
GLIHUB_DATA_DIR=./data

# PostgreSQL 18 (pgvector)
POSTGRES_DB=glihub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Valkey 9.x (100% 兼容 Redis 协议)
VALKEY_PORT=6379
REDIS_PASSWORD=

# 服务端口
BACKEND_PORT=8080
AI_SERVICE_PORT=8090
EDGE_PORT=8091
FRONTEND_PORT=8088

# 端云协同安全共享令牌与 JWT 密钥
EDGE_SHARED_TOKEN=glihub-edge-shared-token-v3
JWT_SECRET=glihub-v3-industrial-ehs-jwt-hmac-secret-key-2026-secure

# VLM / LLM OpenAI-Compatible 配置（local-q4 对接本地 Ollama；cpu-int8 可接远端 API 或自动规则兜底）
VLM_BASE_URL=http://host.docker.internal:11434/v1
VLM_API_KEY=
VLM_MODEL=qwen3-vl:4b

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ============================================================================
# GliHub 2.0 - FastAPI AI 推理与智能体微服务环境变量模板
# 所有 VLM / LLM / Embedding 均遵循 OpenAI-Compatible API 规范，零厂商锁定
# ============================================================================

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
DEFAULT_DEVICE=auto

# 存量 YOLOv5 目录与检测结果图片输出路径
YOLOV5_REPO_DIR=../yolov5target-main
OUTPUT_DIR=./outputs
YOLOV5_COUPLED_PERSON_CHECK=true

# 扩展视觉适配器启用开关（Apple M1 Pro 16GB 默认懒加载，GPU 服务器可全开）
ENABLE_YOLO26=true
ENABLE_RFDETR=false
ENABLE_YOLOE=true

# PostgreSQL 16 (pgvector / JSONB 混合检索自动适配)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glihub
DB_USER=postgres
DB_PASSWORD=postgres

# ----------------------------------------------------------------------------
# 1. 视觉多模态复核模型 (VLM: Qwen3-VL / Qwen2.5-VL / InternVL3)
# 本地 Ollama 示例: VLM_BASE_URL=http://localhost:11434/v1  VLM_MODEL=qwen2.5vl:7b
# 云端兼容示例:     VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 未配置 API_KEY 且本地 Ollama 未启动时，自动启用规则引擎 + 法规模板无损兜底
# ----------------------------------------------------------------------------
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT_SEC=30

# ----------------------------------------------------------------------------
# 2. 安全大脑推理模型 (LLM: DeepSeek-V3.2 / R1 / Qwen3.5)
# DeepSeek 示例: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 本地 Ollama:   LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=qwen3:8b
# ----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SEC=45

# ----------------------------------------------------------------------------
# 3. 知识库向量化 (Embedding: Qwen3-Embedding) 与文档解析 (OCR)
# 未配置外部 Embedding 端点时，自动使用内置确定性特征向量 + 关键词混合检索
# ----------------------------------------------------------------------------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=deepseek-ocr-2

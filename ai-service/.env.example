# GliHub 3.0 AI-Service Deployment Profile: cpu-int8 | local-q4 | gpu-pro
DEPLOY_PROFILE=cpu-int8
DEFAULT_PRECISION=int8
DEFAULT_IMGSZ=640
CPU_THREADS=0

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090

# PostgreSQL 18 (pgvector) connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glihub
DB_USER=postgres
DB_PASSWORD=postgres

# mod-vlm (Local Ollama Q4_K_M e.g. qwen3-vl:4b / qwen2.5vl:7b or remote OpenAI-compatible API)
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=
VLM_MODEL=qwen3-vl:4b

# mod-llm-rag (Local Ollama Q4_K_M e.g. qwen3:8b / deepseek-r1:8b or remote OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b

# Embedding (ONNX INT8 local or remote OpenAI-compatible /v1/embeddings)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# mod-ocr (DeepSeek-OCR 2 / PaddleOCR-VL API or local PP-OCR INT8 fallback)
OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=deepseek-ocr-2
